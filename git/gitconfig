[alias]
  st = status -sb
  lg = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
  cim = commit -m
  rbi = rebase -i
  sw = switch
  co = checkout
  br = branch
  cob = checkout -b

  wtl = worktree list
  wtr = worktree remove
  wtp = worktree prune
  wte = "!f(){ b=\"$1\"; [ -n \"$b\" ] || { echo 'usage: git wte <origin-branch>' >&2; return 2; }; b=\"${b#origin/}\"; root=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\"); dir=\"$root/$(printf '%s' \"$b\" | tr / -)\"; git fetch origin --prune && git worktree add --guess-remote \"$dir\" \"$b\"; }; f"
  wtn = "!f(){ b=\"$1\"; base=\"${2:-origin/main}\"; [ -n \"$b\" ] || { echo 'usage: git wtn <branch> [base]' >&2; return 2; }; root=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\"); dir=\"$root/$(printf '%s' \"$b\" | tr / -)\"; git fetch origin --prune && git worktree add --no-track -b \"$b\" \"$dir\" \"$base\"; }; f"
