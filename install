#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
bash_dir="$repo_dir/bash"
git_config="$repo_dir/git/gitconfig"
ghostty_terminfo="$repo_dir/terminfo/xterm-ghostty.terminfo"
starship_config="$repo_dir/starship.toml"
herdr_config="$repo_dir/herdr/config.toml"
hunk_config="$repo_dir/hunk/config.toml"
setup_coder_dir="$HOME/.config/setup_coder"
user_bin="$HOME/.local/bin"

bash_begin="# >>> setup_coder bash_rc >>>"
bash_end="# <<< setup_coder bash_rc <<<"
profile_begin="# >>> setup_coder bash_profile >>>"
profile_end="# <<< setup_coder bash_profile <<<"
git_begin="# >>> setup_coder gitconfig >>>"
git_end="# <<< setup_coder gitconfig <<<"

log() {
  echo "==> $*"
}

warn() {
  echo "warning: $*" >&2
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_file() {
  [[ -f "$1" ]] || die "missing $1"
}

require_dir() {
  [[ -d "$1" ]] || die "missing $1"
}

install_file() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
}

copy_dir() {
  local src="$1" dst="$2"
  mkdir -p "$dst"
  cp -a "$src/." "$dst/"
  find "$dst" -type f -name '._*' -delete
}

install_ghostty_terminfo() {
  if command -v infocmp >/dev/null 2>&1 && infocmp -x xterm-ghostty >/dev/null 2>&1; then
    log "xterm-ghostty terminfo already installed"
    return
  fi

  if ! command -v tic >/dev/null 2>&1; then
    warn "tic not found; skipping xterm-ghostty terminfo"
    return
  fi

  mkdir -p "$HOME/.terminfo"
  if tic -x -o "$HOME/.terminfo" "$ghostty_terminfo"; then
    log "installed xterm-ghostty terminfo"
  else
    warn "failed to install xterm-ghostty terminfo"
  fi
}

inject_bash_rc() {
  local bashrc="$HOME/.bashrc"
  local next

  touch "$bashrc"
  next="$(mktemp)"

  awk -v begin="$bash_begin" -v end="$bash_end" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    !skip { print }
  ' "$bashrc" > "$next"

  {
    cat "$next"
    echo
    echo "$bash_begin"
    echo '[ -f "$HOME/.config/setup_coder/bash_rc" ] && . "$HOME/.config/setup_coder/bash_rc"'
    echo "$bash_end"
  } > "$bashrc"

  rm -f "$next"
}

inject_bash_profile() {
  local profile="$HOME/.bash_profile"
  local next

  touch "$profile"
  next="$(mktemp)"

  awk -v begin="$profile_begin" -v end="$profile_end" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    !skip { print }
  ' "$profile" > "$next"

  {
    cat "$next"
    echo
    echo "$profile_begin"
    echo '[ -f "$HOME/.config/setup_coder/bash_profile" ] && . "$HOME/.config/setup_coder/bash_profile"'
    echo "$profile_end"
  } > "$profile"

  rm -f "$next"
}

ensure_gitconfig_include() {
  local gitconfig="$HOME/.gitconfig"
  local next

  touch "$gitconfig"
  next="$(mktemp)"

  awk -v begin="$git_begin" -v end="$git_end" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    !skip { print }
  ' "$gitconfig" > "$next"

  {
    cat "$next"
    echo
    echo "$git_begin"
    echo "[include]"
    echo "  path = ~/.config/setup_coder/gitconfig"
    echo "$git_end"
  } > "$gitconfig"

  rm -f "$next"
}

install_tpm() {
  local dst="$HOME/.tmux/plugins/tpm"

  if [[ -d "$dst/.git" ]]; then
    log "TPM already installed"
    return
  fi

  if ! command -v git >/dev/null 2>&1; then
    warn "git not found; skipping TPM"
    return
  fi

  log "cloning TPM"
  if ! git clone --depth=1 https://github.com/tmux-plugins/tpm "$dst"; then
    warn "failed to clone TPM; tmux config is still installed"
  fi
}

install_tmux_plugins() {
  local installer="$HOME/.tmux/plugins/tpm/bin/install_plugins"

  if [[ ! -x "$installer" ]]; then
    warn "TPM installer not found; skipping tmux plugin install"
    return
  fi

  log "installing tmux plugins"
  if ! "$installer"; then
    warn "failed to install tmux plugins"
  fi
}

install_starship() {
  if [[ -x "$user_bin/starship" ]]; then
    log "starship already installed"
    return
  fi

  log "installing starship"
  if ! (curl -fsSL https://starship.rs/install.sh | sh -s -- -b "$user_bin" -y) >/dev/null 2>&1; then
    warn "failed to install starship"
  fi
}

install_hunk() {
  local tmp binary

  if [[ -x "$user_bin/hunk" ]]; then
    log "hunk already installed"
    return
  fi

  log "installing hunk"
  tmp="$(mktemp -d)"

  if ! curl -fsSL "https://github.com/modem-dev/hunk/releases/latest/download/hunkdiff-linux-x64.tar.gz" -o "$tmp/hunk.tar.gz"; then
    warn "failed to download hunk"
    rm -rf "$tmp"
    return
  fi

  if ! tar -xzf "$tmp/hunk.tar.gz" -C "$tmp"; then
    warn "failed to extract hunk"
    rm -rf "$tmp"
    return
  fi

  binary=""
  while IFS= read -r candidate; do
    binary="$candidate"
    break
  done < <(find "$tmp" -type f \( -name hunk -o -name hunkdiff \))

  if [[ -z "$binary" ]]; then
    warn "hunk binary not found in release archive"
    rm -rf "$tmp"
    return
  fi

  if ! install -m 755 "$binary" "$user_bin/hunk"; then
    warn "failed to install hunk"
    rm -rf "$tmp"
    return
  fi

  rm -rf "$tmp"
  log "installed hunk"
}

require_file "$bash_dir/bash_profile"
require_file "$bash_dir/bash_rc"
require_file "$git_config"
require_file "$ghostty_terminfo"
require_file "$starship_config"
require_file "$herdr_config"
require_file "$hunk_config"
require_file "$repo_dir/tmux.conf"
require_dir "$repo_dir/bin"
require_dir "$repo_dir/nvim"
require_dir "$repo_dir/k9s"

mkdir -p \
  "$setup_coder_dir" \
  "$HOME/.config/herdr" \
  "$HOME/.config/hunk" \
  "$HOME/.config/tmux" \
  "$HOME/.config/nvim" \
  "$HOME/.config/k9s" \
  "$HOME/.tmux/plugins" \
  "$user_bin"

install_ghostty_terminfo

install_starship
install_hunk

log "installing starship config"
install_file "$starship_config" "$HOME/.config/starship.toml"

log "installing herdr config"
install_file "$herdr_config" "$HOME/.config/herdr/config.toml"

log "installing hunk config"
install_file "$hunk_config" "$HOME/.config/hunk/config.toml"

log "installing bash files"
install_file "$bash_dir/bash_rc" "$setup_coder_dir/bash_rc"
install_file "$bash_dir/bash_profile" "$setup_coder_dir/bash_profile"

log "injecting bash profile"
inject_bash_profile

log "injecting bash rc"
inject_bash_rc

if awk -v begin="$bash_begin" -v end="$bash_end" '
  $0 == begin { skip = 1; next }
  $0 == end { skip = 0; next }
  !skip { print }
' "$HOME/.bashrc" | grep -Eq '^[[:space:]]*export[[:space:]]+TERM='; then
  warn "~/.bashrc exports TERM; remove that line if colors/terminfo break"
fi

log "installing git config"
install_file "$git_config" "$setup_coder_dir/gitconfig"
ensure_gitconfig_include

log "installing user bin"
copy_dir "$repo_dir/bin" "$user_bin"

log "installing tmux config"
install_file "$repo_dir/tmux.conf" "$HOME/.config/tmux/tmux.conf"

log "copying nvim config"
copy_dir "$repo_dir/nvim" "$HOME/.config/nvim"

log "copying k9s config"
copy_dir "$repo_dir/k9s" "$HOME/.config/k9s"

install_tpm
install_tmux_plugins

log "setup complete"
