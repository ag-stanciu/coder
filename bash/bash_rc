# envs
export GPG_TTY=$(tty)
export CLICOLOR=1
export EDITOR='nvim'
export LC_CTYPE=C.UTF-8
export HISTFILE="$HOME/.bash_history"
export HISTSIZE=50000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth:erasedups
export HISTIGNORE='history:exit:pwd:clear:bg:fg'

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

shopt -s histappend
shopt -s cmdhist
shopt -s lithist

if [[ -z "${TMUX:-}" && "${TERM:-}" == "xterm-256color" ]] && infocmp -x xterm-ghostty >/dev/null 2>&1; then
  export TERM=xterm-ghostty
fi

alias aws-sso='aws sso login --use-device-code'
alias tt='tmux new-session -A -s main'
