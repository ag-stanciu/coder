# envs
export GPG_TTY=$(tty)
export CLICOLOR=1
export EDITOR='nvim'
export LC_CTYPE=C.UTF-8

if [[ -z "${TMUX:-}" && "${TERM:-}" == "xterm-256color" ]] && infocmp -x xterm-ghostty >/dev/null 2>&1; then
  export TERM=xterm-ghostty
fi

alias aws-sso='aws sso login --use-device-code'
alias tt='tmux new-session -A -s main'
